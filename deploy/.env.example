# Copy to .env on your workstation/server; never commit the populated .env.
DOMAIN=food.example.com
BACKEND_IMAGE=your-registry.example.com/food-to-eat/backend:release-1
FRONTEND_IMAGE=your-registry.example.com/food-to-eat/frontend:release-1
# Use three different, long random passwords. No defaults are supplied by Compose.
POSTGRES_PASSWORD=replace-with-postgres-admin-password
DB_PASSWORD=replace-with-app-database-password
REDIS_PASSWORD=replace-with-redis-password
