<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.foodtoeat.mapper.FoodMapper">

    <select id="pageQuery" resultType="com.foodtoeat.pojo.entity.Food">
        SELECT * FROM foods
        order by name desc
        LIMIT #{pageSize}
        OFFSET #{offset}
    </select>
    <select id="getFoodByCategory"
            parameterType="com.foodtoeat.pojo.dto.FoodCategoryFilterDTO"
            resultType="com.foodtoeat.pojo.entity.Food">
        SELECT * FROM foods
        <where>
            <!-- Include foods with ALL included categories -->
            <if test="includeCategoryIds != null and includeCategoryIds.size() > 0">
                foods.id IN (
                SELECT fc.food_id
                FROM food_category fc
                WHERE fc.category_id IN
                <foreach collection="includeCategoryIds"
                         item="categoryId"
                         open="("
                         separator=","
                         close=")">
                    #{categoryId}
                </foreach>
                GROUP BY fc.food_id
                HAVING COUNT(DISTINCT fc.category_id)
                = #{includeCategoryIds.size}
                )
            </if>

            <!-- Exclude foods with any excluded category -->
            <if test="excludeCategoryIds != null and excludeCategoryIds.size() > 0">
                AND foods.id NOT IN (
                SELECT fc.food_id
                FROM food_category fc
                WHERE fc.category_id IN
                <foreach collection="excludeCategoryIds"
                         item="categoryId"
                         open="("
                         separator=","
                         close=")">
                    #{categoryId}
                </foreach>
                )
            </if>

            <!-- Exclude foods already rejected during this session -->
            <if test="rejectedFoodIds != null and rejectedFoodIds.size() > 0">
                AND foods.id NOT IN
                <foreach collection="rejectedFoodIds"
                         item="foodId"
                         open="("
                         separator=","
                         close=")">
                    #{foodId}
                </foreach>
            </if>
        </where>
    </select>
</mapper>
